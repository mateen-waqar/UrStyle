// -----------------------------------------------------------------------------
// StyleOS Prisma Schema
// Premium Digital Wardrobe, Rule-Based Outfit Generation & 3D Avatar Engine
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum GenderPreference {
  MALE
  FEMALE
  UNISEX
  NON_BINARY
}

enum AestheticType {
  MINIMALIST
  QUIET_LUXURY
  STREETWEAR
  CLASSIC_TAILORING
  SMART_CASUAL
  AVANT_GARDE
  ATHLEISURE
  OLD_MONEY
  MONOCHROME
  BOHEMIAN
}

enum BodyShape {
  RECTANGLE
  INVERTED_TRIANGLE
  HOURGLASS
  PEAR
  ATHLETIC
  OVAL
}

enum PreferredFit {
  SLIM
  REGULAR
  RELAXED
  OVERSIZED
}

enum GarmentCategory {
  TOP
  BOTTOM
  FOOTWEAR
  OUTERWEAR
  ACCESSORY
  HEADWEAR
  EYEWEAR
  TIMEPIECE
  BAG
  JEWELRY
}

enum GarmentSlot {
  HEAD
  FACE
  NECK
  INNER_TOP
  OUTER_TOP
  BOTTOM
  FOOTWEAR
  WRIST
  ACCESSORY_PRIMARY
  ACCESSORY_SECONDARY
}

enum GarmentPattern {
  SOLID
  STRIPED
  CHECKERED
  FLORAL
  GRAPHIC
  TEXTURED
  HERRINGBONE
  HOUNDSTOOTH
  PAISLEY
}

enum GarmentMaterial {
  COTTON
  LINEN
  WOOL
  CASHMERE
  SILK
  DENIM
  LEATHER
  SUEDE
  SYNTHETIC
  FLEECE
  BLEND
}

enum FormalityLevel {
  CASUAL
  SMART_CASUAL
  BUSINESS_CASUAL
  BUSINESS_FORMAL
  BLACK_TIE
}

enum Season {
  SPRING
  SUMMER
  FALL
  WINTER
  ALL_SEASON
}

enum WeatherSuitability {
  COLD
  MILD
  WARM
  HOT
  RAIN
  WIND
}

enum OccasionType {
  WORK
  DATE_NIGHT
  CASUAL_OUTING
  FORMAL_EVENT
  TRAVEL
  LOUNGE
  ATHLETIC
  GALA
  PARTY
}

enum GenerationSource {
  DETERMINISTIC_ENGINE
  MANUAL_BUILDER
  STYLING_RULE
  CUSTOM_TEMPLATE
}

enum RuleType {
  COLOR_HARMONY
  SILHOUETTE_PROPORTION
  FORMALITY_MATCH
  TEXTURE_COMPATIBILITY
  WEATHER_APPROPRIATENESS
  LAYER_ORDER
  CATEGORY_MUTEX
}

enum StylingTipType {
  TUCK
  ROLL
  BUTTON
  LAYER
  ACCESSORIZE
  PROPORTION
  COLOR_ACCENT
}

enum AvatarGender {
  MALE
  FEMALE
  ANDROGYNOUS
}

enum TimeOfDay {
  MORNING
  AFTERNOON
  EVENING
  ALL_DAY
}

enum ItemStatus {
  AVAILABLE
  LAUNDRY
  UNAVAILABLE
  ARCHIVED
}

// -----------------------------------------------------------------------------
// CORE USER & PROFILE MODELS
// -----------------------------------------------------------------------------

/// AppUser maps 1:1 to Supabase Auth UUID (auth.users.id)
model AppUser {
  id               String            @id // Matches Supabase Auth auth.users.id
  email            String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relationships
  profile          UserProfile?
  wardrobeItems    WardrobeItem[]
  outfits          Outfit[]
  avatarProfiles   AvatarProfile[]
  savedCollections SavedCollection[]
  savedOutfits     SavedOutfit[]
  calendarEntries  CalendarEntry[]
  styleRules       StyleRule[]

  @@map("app_users")
}

model UserProfile {
  id                  String            @id @default(uuid())
  userId              String            @unique
  user                AppUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName         String?
  bio                 String?
  genderPreference    GenderPreference? @default(UNISEX)
  aesthetic           AestheticType?    @default(MINIMALIST)
  favoriteColors      String[]          @default([])
  lifestyle           String?
  bodyShape           BodyShape?
  skinTone            String?
  heightCm            Float?
  weightKg            Float?
  preferredFit        PreferredFit?     @default(REGULAR)
  city                String?
  country             String?
  onboardingCompleted Boolean           @default(false)
  onboardingStep      Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
  @@map("user_profiles")
}

// -----------------------------------------------------------------------------
// DIGITAL WARDROBE MODELS
// -----------------------------------------------------------------------------

model WardrobeItem {
  id                 String              @id @default(uuid())
  userId             String
  user               AppUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  category           GarmentCategory
  subCategory        String
  brand              String?
  size               String?
  colorPrimary       String              // Hex string or standard palette label
  colorSecondary     String?
  pattern            GarmentPattern      @default(SOLID)
  material           GarmentMaterial     @default(COTTON)
  fit                PreferredFit?       @default(REGULAR)
  style              AestheticType?      @default(SMART_CASUAL)
  formality          FormalityLevel      @default(CASUAL)
  seasonality        Season[]
  occasions          OccasionType[]      @default([CASUAL_OUTING])
  weatherSuitability WeatherSuitability[]
  status             ItemStatus          @default(AVAILABLE)
  imageUrl           String?             // Supabase Storage URL
  storagePath        String?             // Supabase Storage bucket path
  thumbnailUrl       String?
  isArchived         Boolean             @default(false)
  isFavorite         Boolean             @default(false)
  wearCount          Int                 @default(0)
  lastWornAt         DateTime?
  purchasePrice      Decimal?            @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relationships
  outfitItems        OutfitItem[]
  garmentMapping     WardrobeGarmentMapping?

  @@index([userId, category])
  @@index([userId, formality])
  @@index([userId, status])
  @@index([userId, isArchived])
  @@map("wardrobe_items")
}

// -----------------------------------------------------------------------------
// OUTFIT & STYLING MODELS
// -----------------------------------------------------------------------------

model Outfit {
  id                  String               @id @default(uuid())
  userId              String
  user                AppUser              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  occasion            OccasionType         @default(CASUAL_OUTING)
  formality           FormalityLevel       @default(CASUAL)
  season              Season               @default(ALL_SEASON)
  generationSource    GenerationSource     @default(DETERMINISTIC_ENGINE)
  compatibilityScore  Float?               // 0.0 - 1.0 calculated by deterministic engine
  colorHarmonyScore   Float?               // 0.0 - 1.0 color wheel rule metric
  styleBalanceScore   Float?               // 0.0 - 1.0 silhouette & formality metric
  isFavorite          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Relationships
  items               OutfitItem[]
  savedOutfits        SavedOutfit[]
  calendarEntries     CalendarEntry[]
  stylingInstructions StylingInstruction[]

  @@index([userId, formality])
  @@index([userId, occasion])
  @@index([userId, createdAt])
  @@map("outfits")
}

model OutfitItem {
  id             String       @id @default(uuid())
  outfitId       String
  outfit         Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  wardrobeItemId String
  wardrobeItem   WardrobeItem @relation(fields: [wardrobeItemId], references: [id], onDelete: Cascade)
  slot           GarmentSlot
  layerIndex     Int          @default(0) // 0: base, 1: mid-layer, 2: outer/overcoat
  isRequired     Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([outfitId, slot])
  @@index([wardrobeItemId])
  @@map("outfit_items")
}

model StyleRule {
  id          String    @id @default(uuid())
  userId      String?   // Null for global system rule; set for user-defined overrides
  user        AppUser?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  ruleType    RuleType
  priority    Int       @default(10) // 1 (lowest) to 100 (highest priority)
  isActive    Boolean   @default(true)
  conditions  Json      // Declarative predicate structure for the deterministic engine
  actions     Json      // Scoring adjustments or filtering constraints
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, ruleType])
  @@index([isActive, priority])
  @@map("style_rules")
}

model StylingInstruction {
  id          String         @id @default(uuid())
  outfitId    String
  outfit      Outfit         @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  garmentSlot GarmentSlot
  instruction String
  tipType     StylingTipType @default(LAYER)
  createdAt   DateTime       @default(now())

  @@index([outfitId])
  @@map("styling_instructions")
}

// -----------------------------------------------------------------------------
// 3D AVATAR & VIRTUAL STUDIO MODELS
// -----------------------------------------------------------------------------

model AvatarProfile {
  id            String       @id @default(uuid())
  userId        String
  user          AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  gender        AvatarGender @default(ANDROGYNOUS)
  meshType      String       @default("stylized_v1")
  skinColor     String       @default("#f2d6c1") // Hex
  hairStyle     String       @default("classic_taper")
  hairColor     String       @default("#2c221e")
  eyeColor      String       @default("#4a3728")
  heightScale   Float        @default(1.0)
  shoulderWidth Float        @default(1.0)
  waistWidth    Float        @default(1.0)
  hipWidth      Float        @default(1.0)
  baseModelUrl  String?      // Supabase Storage GLB URL
  isDefault     Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, isDefault])
  @@map("avatar_profiles")
}

model GarmentAsset {
  id               String                  @id @default(uuid())
  name             String
  category         GarmentCategory
  slot             GarmentSlot
  gender           AvatarGender            @default(ANDROGYNOUS)
  modelFileUrl     String                  // glTF / GLB file in Supabase Storage
  thumbnailUrl     String?
  textureMapUrl    String?
  normalMapUrl     String?
  roughnessMapUrl  String?
  supportedBones   String[]                // Target rig bone attachments e.g. ["Spine", "Chest"]
  scaleAdjustment  Json?                   // Default { x: 1, y: 1, z: 1 }
  offsetAdjustment Json?                   // Default { x: 0, y: 0, z: 0 }
  isSystemAsset    Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Relationships
  mappings         WardrobeGarmentMapping[]

  @@index([category, slot, gender])
  @@map("garment_assets")
}

model WardrobeGarmentMapping {
  id                     String        @id @default(uuid())
  wardrobeItemId         String        @unique
  wardrobeItem           WardrobeItem  @relation(fields: [wardrobeItemId], references: [id], onDelete: Cascade)
  garmentAssetId         String
  garmentAsset           GarmentAsset  @relation(fields: [garmentAssetId], references: [id], onDelete: Restrict)
  primaryColorOverride   String?       // Dynamic shader uniform override
  secondaryColorOverride String?
  textureOverrideUrl     String?
  roughness              Float?        @default(0.7)
  metalness              Float?        @default(0.1)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([garmentAssetId])
  @@map("wardrobe_garment_mappings")
}

// -----------------------------------------------------------------------------
// SAVED COLLECTIONS, OUTFITS & CALENDAR
// -----------------------------------------------------------------------------

model SavedCollection {
  id           String        @id @default(uuid())
  userId       String
  user         AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  isPrivate    Boolean       @default(true)
  coverImageUrl String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relationships
  savedOutfits SavedOutfit[]

  @@index([userId, isPrivate])
  @@map("saved_collections")
}

model SavedOutfit {
  id           String           @id @default(uuid())
  userId       String
  user         AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitId     String
  outfit       Outfit           @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   SavedCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  notes        String?
  createdAt    DateTime         @default(now())

  @@index([userId, outfitId])
  @@index([collectionId])
  @@map("saved_outfits")
}

model CalendarEntry {
  id            String    @id @default(uuid())
  userId        String
  user          AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitId      String
  outfit        Outfit    @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  scheduledDate DateTime
  timeOfDay     TimeOfDay @default(ALL_DAY)
  occasion      String?
  isWorn        Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, scheduledDate])
  @@index([outfitId])
  @@map("calendar_entries")
}
